/* =============================================
   REGLAS DE IMPRESIÓN (IMPRIMIR / GUARDAR EN PDF)
   ============================================= */
@media print {
    /* Oculta menúes, barra lateral, encabezados y botones */
    .main-header, 
    .main-sidebar, 
    .content-header, 
    .box-primary, 
    .btn, 
    footer {
        display: none !important;
    }
    
    /* Expande la factura a todo el ancho de la hoja */
    .col-md-7, .col-lg-7, .col-xs-12 {
        width: 100% !important;
        float: none !important;
    }
    
    .box, .box-success {
        border: none !important;
        box-shadow: none !important;
    }

    body {
        background: #fff !important;
        color: #000 !important;
        font-size: 12pt;
    }
}